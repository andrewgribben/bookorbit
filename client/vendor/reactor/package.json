{
  "name": "reactor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Standalone web-based EPUB renderer.",
  "main": "dist/reactor.js",
  "module": "dist/reactor.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/reactor.js",
      "default": "./dist/reactor.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:android": "vite build --config vite.config.android.ts",
    "build:shell-harness": "tsx scripts/build-shell-harness.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/check-host-neutral.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "pnpm run build:android && pnpm run build:shell-harness && playwright test",
    "record:legacy": "tsx scripts/record-legacy.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.48.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.15.0",
    "express": "^5.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "dependencies": {
    "yauzl": "^3.2.0"
  }
}
