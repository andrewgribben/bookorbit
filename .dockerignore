**/node_modules
**/.git
**/dist
# vendored Reactor build output (W1-B1): a committed artifact, not a build byproduct, and the
# client Docker stage needs it both before and after `pnpm install`.
!client/vendor/reactor/dist
**/*.log
.env
client/.env
server/.env
docker/postgres/data
/data
/books
/book-bucket
/local
/coverage
/test-results
**/*.tsbuildinfo
# private git submodule (personal Readwise adapter): never ship it in the image
/private
